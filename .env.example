APP_NAME=RecallOps
DATABASE_URL=sqlite:///./incident_memory.db
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=512
USE_BEDROCK=false
REQUIRE_COCKROACHDB=false
COMPETITION_MODE=false
MINIMUM_RELEVANCE=0.15
USE_COCKROACH_MCP=false
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
# COCKROACH_MCP_API_KEY=service-account-secret-key
# COCKROACH_MCP_CLUSTER_ID=cluster-uuid
COCKROACH_MCP_DATABASE=defaultdb
COCKROACH_MCP_TIMEOUT_SECONDS=20
# API_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
